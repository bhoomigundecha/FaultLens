# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Environment variables ─────────────────────────────────────────────────────
# Secrets live in backend/.env (Groq key) — never commit it.
.env
.env.*
!.env.example
# demo/.env is the Astronomy Shop's public default config (no real secrets);
# docker compose needs it, so it IS committed.
!demo/.env

# ── pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.cover

# ── Alembic ───────────────────────────────────────────────────────────────────
# Keep versions/ tracked — don't ignore migration files
alembic/__pycache__/

# ── Node / Next.js (frontend) ─────────────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*

# ── Docker ────────────────────────────────────────────────────────────────────
# Don't ignore docker-compose — it's part of the project
*.log

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OpenTelemetry Demo (git submodule-like — keep .git of demo intact) ────────
# demo/ is a cloned repo — its own .gitignore handles its internals

# ── AI coding assistants ──────────────────────────────────────────────────────
.claude/
.codex/
.cursor/
.cursorrules
CLAUDE.local.md

# ── FaultLens run artefacts (regenerated every demo / test run) ───────────────
demo-run.log
demo/faultlens/fault-history.log
diagnostics/
backend/scripts/__pycache__/

# ── Temporary archives / scratch ─────────────────────────────────────────────
*.tgz
*.zip
.claude-sync-*
tmp/
*.tmp
*.bak

# ── Misc tooling caches ──────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
coverage/
*.tsbuildinfo

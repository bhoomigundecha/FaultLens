# ─── Kafka / Redpanda ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ─── TimescaleDB (metrics) ────────────────────────────────────────────────────
TIMESCALE_URL=postgresql+asyncpg://faultlens:faultlens@localhost:5432/faultlens_metrics
TIMESCALE_SYNC_URL=postgresql://faultlens:faultlens@localhost:5432/faultlens_metrics

# ─── Elasticsearch (logs) ─────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Neo4j (service + causal graph) ──────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=faultlens123

# ─── PostgreSQL (incidents + agent checkpoints) ───────────────────────────────
POSTGRES_URL=postgresql+asyncpg://faultlens:faultlens@localhost:5433/faultlens
POSTGRES_SYNC_URL=postgresql://faultlens:faultlens@localhost:5433/faultlens

# ─── LLM Provider (groq | ollama) ──────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ─── Ollama (fallback / local) ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Anomaly Detection Thresholds ────────────────────────────────────────────
ZSCORE_THRESHOLD=3.0
ISOLATION_FOREST_CONTAMINATION=0.1
METRIC_WINDOW_MINUTES=15

# ─── Agent Worker ─────────────────────────────────────────────────────────────
AGENT_POLL_INTERVAL_SECONDS=30

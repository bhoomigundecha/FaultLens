# ─── FaultLens Backend Environment ────────────────────────────────────────────

# Application
APP_NAME=FaultLens
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database (Phase 1)
DATABASE_URL=postgresql+asyncpg://faultlens:faultlens@localhost:5432/faultlens
DATABASE_URL_SYNC=postgresql://faultlens:faultlens@localhost:5432/faultlens

# AI / LLM (Phase 17)
# Get your free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Telemetry Correlation (Phase 11)
# Metric context window around a trace — in nanoseconds (default: ±30s)
CORRELATION_WINDOW_NS=30000000000

# Real-time pipeline (background loop: detect → incidents → RCA → AI)
PIPELINE_AUTO_RUN=true
PIPELINE_INTERVAL_SECONDS=30
AI_AUTO_EXPLAIN=true
DETECTION_IGNORE_SERVICES=load-generator,frontend-web

# Raw telemetry older than this is deleted (incidents/RCA are kept)
TELEMETRY_RETENTION_MINUTES=60
